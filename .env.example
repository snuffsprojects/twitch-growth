# Twitch application credentials from https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Generate these before exposing the app beyond localhost.
# python -c 'from werkzeug.security import generate_password_hash; print(generate_password_hash("change-me"))'
TWITCH_GROWTH_ADMIN_PASSWORD_HASH=
# python -c 'import secrets; print(secrets.token_hex(32))'
TWITCH_GROWTH_SESSION_SECRET=
# Set to true when the browser always reaches the application over HTTPS.
TWITCH_GROWTH_SECURE_COOKIES=false

# Deployment defaults
TWITCH_GROWTH_PREFIX=
TWITCH_GROWTH_TIMEZONE=Europe/London
TWITCH_GROWTH_CHANNEL_URL=https://www.twitch.tv/your_channel
TWITCH_GROWTH_DB=/data/twitch_growth.db
TWITCH_GROWTH_DASHBOARD_URL=/
PORT=5120

# Steam can instead be configured through the protected Settings page.
STEAM_ID64=
STEAM_API_KEY=
